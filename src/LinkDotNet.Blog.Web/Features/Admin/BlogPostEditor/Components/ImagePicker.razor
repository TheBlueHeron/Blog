@using System.IO
@using LinkDotNet.Blog.Web.Features.Services.Files
@inject IBlobService BlobService
@inject IJSRuntime JSRuntime
@inject IToastService ToastService

<ul class="nav nav-tabs mb-2">
	<li class="nav-item">
		<a class="nav-link @( _Mode == Mode.Select ? "active" : "" )" @onclick="() => SetMode(Mode.Select)" title="Select an existing image">Select</a>
	</li>
	<li class="nav-item">
		<a class="nav-link @( _Mode == Mode.Upload ? "active" : "" )" @onclick="() => SetMode(Mode.Upload)" title="Upload an image">Upload</a>
	</li>
	<li class="nav-item">
		<a class="nav-link @( _Mode == Mode.Url ? "active" : "" )" @onclick="() => SetMode(Mode.Url)" title="Enter an URL">URL</a>
	</li>
</ul>
<div class="d-flex">
	@if (_Mode == Mode.Upload)
	{
		<InputText type="url" class="form-control" id="previewUpload" @bind-Value="Value" readonly />
		<button type="button" class="toolbar-btn" title="Upload image" @onclick="ShowImageUpload">
			<i class="bi bi-upload"></i>
		</button>
	}
	else if (_Mode == Mode.Select)
	{
		<select class="form-control" id="previewSelect" @onchange="OnSelectChanged">
			<option value="">- Choose an image -</option>
			@foreach (var file in _files)
			{
				if (file.Url == Value)
				{
					<option value="@file.Item2" selected>@file.Item1</option>
				}
				else
				{
					<option value="@file.Item2">@file.Item1</option>
				}
			}
		</select>
	}
	else
	{
		<InputText type="url" class="form-control" id="previewUrl" @bind="Value" ValueChanged="OnValueChanged" ValueExpression="() => Value" @bind:event="oninput" />
	}
</div>
<UploadFileModalDialog @ref="UploadDialog"></UploadFileModalDialog>
<InputFile @ref="inputFileRef" style="display: none;" accept="image/*" OnChange="OnFileSelected" />

@code {
	public enum Mode
	{
		Select,
		Upload,
		Url
	}

	private Mode _Mode = Mode.Select;

	private List<(string Name, string Url)> _files = new();

	private const long MaxFileSizeBytes = 512 * 1024; // 512 KB
	private InputFile inputFileRef = default!;
	private UploadFileModalDialog UploadDialog { get; set; } = default!;

	[Parameter]
	public string Value { get; set; } = string.Empty;

	[Parameter]
	public EventCallback<string> ValueChanged { get; set; }

	protected override async Task OnInitializedAsync()
	{
		var files = await BlobService.GetFilesAsync();
		_files = files.Select(f => (f.Item1, f.Item2)).ToList();
	}

	private async Task OnFileSelected(InputFileChangeEventArgs e)
	{
		if (e.File != null)
		{
			try
			{
				if (e.File.Size > MaxFileSizeBytes)
				{
					ToastService.ShowError($"File '{e.File.Name}' exceeds the maximum allowed size of 512 KB.");
				}
				else
				{
					using var memoryStream = new MemoryStream();
					await e.File.OpenReadStream(maxAllowedSize: MaxFileSizeBytes).CopyToAsync(memoryStream);
					memoryStream.Position = 0;

					var result = await UploadDialog.ShowAsync(e.File.Name);
					if (result != null)
					{
						var url = await BlobService.UploadFileAsync(result.Name, memoryStream, new UploadOptions
						{
							SetCacheControlHeader = result.CacheMedia,
						});

						Value = url;
						await ValueChanged.InvokeAsync(Value);
						ToastService.ShowSuccess($"Successfully uploaded {e.File.Name}");
					}
				}
			}
			catch (Exception ex)
			{
				ToastService.ShowError($"Error while uploading file: {ex.Message}");
			}
		}
	}

	private async Task OnSelectChanged(ChangeEventArgs e)
	{
		Value = e.Value?.ToString() ?? string.Empty;
		await ValueChanged.InvokeAsync(Value);
	}

	private async Task OnValueChanged(string newValue)
	{
		Value = newValue;
		await ValueChanged.InvokeAsync(newValue);
	}

	private void SetMode(Mode mode)
	{
		_Mode = mode;
	}

	private async Task ShowImageUpload()
	{
		await JSRuntime.InvokeVoidAsync("markdownEditor.clickInputFile", inputFileRef.Element);
	}
}
